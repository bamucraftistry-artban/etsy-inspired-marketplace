:root {
  --bg: #fffaf7;
  --panel: #ffffff;
  --primary: #f1641e;
  --primary-dark: #d85612;
  --text: #1f1f1f;
  --muted: #595959;
  --soft: #f4efe9;
  --line: rgba(31, 31, 31, 0.08);
  --shadow: 0 18px 40px rgba(24, 24, 24, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #fffaf6 0%, #fff 15%, #fffaf6 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  width: 100%;
}

#root {
  min-height: 100vh;
}

.page-shell {
  max-width: 1320px;
  margin: 0 auto;
  padding: 24px 36px 80px;
  position: relative;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 0 22px;
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 12px;
  background: linear-gradient(135deg, #ff9b62, #f1641e 60%);
  color: white;
  font-weight: 800;
  box-shadow: var(--shadow);
}

.brand-name {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 700;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 0.95rem;
  color: var(--muted);
}

.main-nav a {
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: var(--text);
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.link-button,
.category-pill,
.secondary-button,
.primary-button,
.cart-button,
.mini-button,
.close-button,
.wish-button {
  border: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.link-button {
  background: transparent;
  color: var(--text);
  font-weight: 600;
}

.link-button:hover,
.category-pill:hover,
.secondary-button:hover,
.primary-button:hover,
.cart-button:hover,
.mini-button:hover,
.close-button:hover,
.wish-button:hover {
  transform: translateY(-1px);
}

.cart-button,
.primary-button,
.mini-button {
  background: var(--primary);
  color: white;
  padding: 0.9rem 1.1rem;
  border-radius: 999px;
  font-weight: 700;
  box-shadow: 0 10px 20px rgba(241, 100, 30, 0.2);
}

.primary-button {
  padding: 0.95rem 1.5rem;
}

.secondary-button {
  background: #fff;
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.95rem 1.4rem;
  font-weight: 700;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 14px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
  border-radius: 26px;
  padding: 16px 18px;
  margin-top: 12px;
}

.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 0 16px;
  min-height: 58px;
}

.search-field span {
  font-size: 1.35rem;
  color: var(--muted);
}

.search-field input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 1rem;
  color: var(--text);
}

.content {
  padding-top: 32px;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 30px;
  padding: 28px 0 12px;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 4vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.06em;
}

.eyebrow {
  margin: 0 0 18px;
  color: var(--primary);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.subtitle {
  margin: 18px 0 0;
  max-width: 620px;
  font-size: 1.08rem;
  line-height: 1.7;
  color: var(--muted);
}

.cta-row {
  display: flex;
  gap: 14px;
  margin-top: 28px;
}

.hero-visual {
  display: flex;
  justify-content: center;
  gap: 18px;
  min-height: 540px;
}

.card {
  overflow: hidden;
  border-radius: 28px;
  background: #fff;
  box-shadow: var(--shadow);
}

.large-card {
  width: min(100%, 420px);
  position: relative;
}

.large-card img,
.collection-card img,
.product-card img,
.cart-item img {
  object-fit: cover;
}

.large-card img {
  height: 100%;
  min-height: 520px;
}

.floating-badge {
  position: absolute;
  left: 18px;
  bottom: 18px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(31, 31, 31, 0.06);
  color: var(--text);
  padding: 0.75rem 0.9rem;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
}

.mini-stack {
  display: flex;
  flex-direction: column;
  gap: 18px;
  justify-content: flex-end;
}

.small-card {
  width: 220px;
  height: 240px;
}

.small-card img {
  height: 100%;
}

.stat-card {
  background: linear-gradient(135deg, #fff3eb, #fff8f3);
  border: 1px solid rgba(241, 100, 30, 0.12);
  border-radius: 24px;
  padding: 20px 18px;
  width: 220px;
  box-shadow: var(--shadow);
}

.stat-card strong {
  display: block;
  font-size: 2rem;
  letter-spacing: -0.06em;
}

.stat-card span {
  color: var(--muted);
}

.category-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.category-pill {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--line);
  color: var(--muted);
  padding: 0.8rem 1.1rem;
  border-radius: 999px;
  font-weight: 600;
}

.category-pill.active {
  background: #fff0ea;
  color: var(--primary-dark);
  border-color: rgba(241, 100, 30, 0.15);
}

.collections {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin-top: 26px;
}

.collection-card {
  position: relative;
  min-height: 300px;
  overflow: hidden;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.collection-card img {
  width: 100%;
  height: 100%;
}

.collection-copy {
  position: absolute;
  inset: auto 0 0 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.56));
  color: white;
  padding: 22px 20px 18px;
}

.collection-copy h3 {
  margin: 0 0 6px;
  font-size: 1.5rem;
}

.collection-copy p {
  margin: 0;
  opacity: 0.9;
}

.peach {
  background: #f8d9c4;
}

.sage {
  background: #dce8d7;
}

.cream {
  background: #f3ead9;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-top: 52px;
  margin-bottom: 24px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 2vw, 2.8rem);
  letter-spacing: -0.05em;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.product-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid var(--line);
  border-radius: 25px;
  overflow: hidden;
  box-shadow: 0 16px 40px rgba(20, 20, 20, 0.05);
}

.image-wrap {
  position: relative;
  height: 260px;
  overflow: hidden;
}

.image-wrap img {
  height: 100%;
}

.wish-button {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: var(--text);
  font-size: 1.2rem;
}

.tag {
  position: absolute;
  left: 14px;
  bottom: 14px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(31, 31, 31, 0.06);
  color: var(--text);
  padding: 0.55rem 0.8rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
}

.product-meta {
  padding: 16px 18px 18px;
}

.product-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
  font-size: 0.78rem;
}

.rating {
  color: #f4b400;
  font-weight: 700;
}

.product-meta h3 {
  margin: 10px 0 14px;
  font-size: 1.15rem;
  line-height: 1.4;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.product-footer strong {
  font-size: 1.2rem;
}

.mini-button {
  padding: 0.7rem 0.9rem;
  font-size: 0.88rem;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: min(420px, 92vw);
  height: 100vh;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  border-left: 1px solid var(--line);
  box-shadow: -20px 0 40px rgba(30, 30, 30, 0.08);
  transform: translateX(105%);
  transition: transform 0.25s ease;
  z-index: 20;
  display: flex;
  flex-direction: column;
}

.cart-drawer.open {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 22px 20px 18px;
  border-bottom: 1px solid var(--line);
}

.drawer-header h3 {
  margin: 0;
  font-size: 1.5rem;
  letter-spacing: -0.05em;
}

.close-button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--soft);
  color: var(--text);
  font-size: 1.8rem;
}

.empty-cart {
  display: grid;
  place-items: center;
  text-align: center;
  color: var(--muted);
  padding: 40px 24px 24px;
}

.empty-cart p {
  margin: 0 0 8px;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text);
}

.cart-items {
  flex: 1;
  padding: 20px;
  overflow: auto;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}

.cart-item img {
  width: 86px;
  height: 86px;
  border-radius: 18px;
}

.cart-item h4 {
  margin: 0 0 6px;
  font-size: 0.96rem;
}

.cart-item p {
  margin: 0;
  color: var(--muted);
}

.drawer-footer {
  padding: 18px 20px 24px;
  border-top: 1px solid var(--line);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  font-size: 1.05rem;
}

.full-width {
  width: 100%;
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .collections,
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .main-nav {
    display: none;
  }
}

@media (max-width: 640px) {
  .page-shell {
    padding-left: 18px;
    padding-right: 18px;
  }

  .topbar {
    flex-wrap: wrap;
  }

  .toolbar {
    width: 100%;
    justify-content: space-between;
  }

  .search-panel {
    flex-direction: column;
    align-items: stretch;
  }

  .cta-row {
    flex-direction: column;
  }

  .collections,
  .product-grid {
    grid-template-columns: 1fr;
  }

  .hero-visual {
    flex-direction: column;
    min-height: auto;
  }

  .small-card,
  .stat-card {
    width: 100%;
  }
}
